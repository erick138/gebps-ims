# GEBPSOICS API - copy to .env (never share the real .env). Lines starting with # are comments.
APP_ENV=production
APP_TIMEZONE=Asia/Manila
# Public address of this API, no trailing slash (used in signed file links). Leave empty to detect automatically.
APP_URL=
# Address of the web app, used in password-reset links, and the browser origins allowed to call this API.
FRONTEND_URL=https://inventory.your-school-domain.example
CORS_ORIGINS=https://inventory.your-school-domain.example

# ---- MySQL / MariaDB (cPanel: MySQL Databases -> create a database and a user with ALL PRIVILEGES)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USER
DB_PASS=YOUR_DATABASE_PASSWORD

# ---- Auth tokens: at least 32 random characters.   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_HEX_CHARS
JWT_TTL=28800

# ---- Uploads are kept in storage/uploads (private). Optional: another absolute folder writable by PHP.
# STORAGE_PATH=/home/youraccount/gebpsoics-uploads

# ---- Password-reset e-mail (optional; without it the reset link is written to storage/logs)
MAIL_FROM=inventory@your-school-domain.example
MAIL_FROM_NAME=GEBPSOICS Inventory
# Leave MAIL_HOST empty to use PHP's mail(); or fill in SMTP (Gmail needs an app password):
MAIL_HOST=
MAIL_PORT=587
MAIL_CRYPTO=tls
MAIL_USER=
MAIL_PASS=
